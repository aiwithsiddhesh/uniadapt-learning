import test from 'node:test';
import assert from 'node:assert/strict';
import {DatabaseSync} from 'node:sqlite';
import {readFileSync} from 'node:fs';
import {sampleCampus} from '../lib/sample.ts';
import {applyAction,mastery,makePlan,eligible,courseHelper,questionFor,expireAttempts,validateGraph,ProductError,localDate} from '../lib/engine.ts';
import {openCampus,saveCampus} from '../lib/store.ts';
import type {Campus} from '../lib/types.ts';
const NOW=new Date('2026-10-13T03:00:00Z');
const seed=()=>sampleCampus('Test learner',NOW);
function answerAll(c:Campus,correct=true){const id=c.attempts.at(-1)!.id;while(c.attempts.find(a=>a.id===id)!.status==='active'){const a=c.attempts.find(a=>a.id===id)!,q=questionFor(c,a)!;c=applyAction(c,{type:'answer',attemptId:a.id,questionId:q.id,answer:correct?q.correct:(q.correct+1)%4},NOW);}return c;}
function evidence(c:Campus,n:number,correctness=1,source:'diagnostic'|'practice'='practice',topicId='values'){for(let i=0;i<n;i++)c.evidence.push({id:'e'+i,learnerId:'learner-me',courseId:'programming',topicId,questionId:'manual-'+i,correctness,source,difficulty:'hard',date:NOW.toISOString(),attemptId:'manual'});}
test('sample courses contain real notes/questions but no fabricated learner scores',()=>{const c=seed();assert.equal(c.courses.length,2);assert.equal(c.courses.flatMap(c=>c.questions).length,36);assert.equal(c.evidence.length,0);assert.ok(c.courses.every(c=>c.sample));assert.equal(mastery(c,'learner-me','values',NOW).visible,false);});
test('adaptive diagnostic starts medium, steps up on correct and down on incorrect',()=>{let c=applyAction(seed(),{type:'startAttempt',learnerId:'learner-me',courseId:'programming',mode:'diagnostic'},NOW);let a=c.attempts[0],q=questionFor(c,a)!;assert.equal(q.difficulty,'medium');c=applyAction(c,{type:'answer',attemptId:a.id,questionId:q.id,answer:q.correct},NOW);a=c.attempts[0];q=questionFor(c,a)!;assert.equal(q.difficulty,'hard');c=applyAction(c,{type:'answer',attemptId:a.id,questionId:q.id,answer:(q.correct+1)%4},NOW);assert.equal(questionFor(c,c.attempts[0])!.difficulty,'medium');});
test('answers remain raw until final grading; submission updates mastery and plan',()=>{let c=applyAction(seed(),{type:'startAttempt',learnerId:'learner-me',courseId:'programming',mode:'diagnostic'},NOW);const a=c.attempts[0],q=questionFor(c,a)!;c=applyAction(c,{type:'answer',attemptId:a.id,questionId:q.id,answer:q.correct},NOW);assert.equal(c.evidence.length,0);c=answerAll(c);assert.equal(c.attempts[0].status,'submitted');assert.equal(c.evidence.length,6);assert.equal(c.plans.length,1);assert.ok(mastery(c,'learner-me','values',NOW).effective>.3);});
test('refresh/reconstruction resumes the exact current question and saved answers',()=>{let c=applyAction(seed(),{type:'startAttempt',learnerId:'learner-me',courseId:'programming',mode:'practice',topicId:'values'},NOW);const a=c.attempts[0],q=questionFor(c,a)!;c=applyAction(c,{type:'answer',attemptId:a.id,questionId:q.id,answer:q.correct},NOW);const restored=JSON.parse(JSON.stringify(c));assert.equal(restored.attempts[0].currentQuestionId,c.attempts[0].currentQuestionId);assert.equal(restored.attempts[0].responses.length,1);});
test('duplicate/stale answer cannot grade twice or answer a different question',()=>{let c=applyAction(seed(),{type:'startAttempt',learnerId:'learner-me',courseId:'programming',mode:'practice',topicId:'values'},NOW);const a=c.attempts[0],q=questionFor(c,a)!;c=applyAction(c,{type:'answer',attemptId:a.id,questionId:q.id,answer:q.correct},NOW);assert.throws(()=>applyAction(c,{type:'answer',attemptId:a.id,questionId:q.id,answer:q.correct},NOW),/question changed/);});
test('timed-out assessment finalizes saved answers once and releases the helper',()=>{let c=applyAction(seed(),{type:'startAttempt',learnerId:'learner-me',courseId:'programming',mode:'diagnostic'},NOW);const a=c.attempts[0],q=questionFor(c,a)!;c=applyAction(c,{type:'answer',attemptId:a.id,questionId:q.id,answer:q.correct},NOW);expireAttempts(c,new Date(NOW.getTime()+16*60000));assert.equal(c.attempts[0].status,'expired');assert.equal(c.evidence.length,1);expireAttempts(c,new Date(NOW.getTime()+17*60000));assert.equal(c.evidence.length,1);assert.ok(courseHelper(c,'learner-me','programming','variables').results.length);});
test('assessment blocks approved-material helper and a second simultaneous attempt',()=>{const c=applyAction(seed(),{type:'startAttempt',learnerId:'learner-me',courseId:'programming',mode:'diagnostic'},NOW);assert.throws(()=>courseHelper(c,'learner-me','programming','variables'),/locked/);assert.throws(()=>applyAction(c,{type:'startAttempt',learnerId:'learner-me',courseId:'mathematics',mode:'diagnostic'},NOW),/active assessment/);});
test('diagnostic question exposure is enforced, while practice remains available',()=>{let c=seed();for(let i=0;i<3;i++){c=applyAction(c,{type:'startAttempt',learnerId:'learner-me',courseId:'programming',mode:'diagnostic'},NOW);c=answerAll(c);}assert.throws(()=>applyAction(c,{type:'startAttempt',learnerId:'learner-me',courseId:'programming',mode:'diagnostic'},NOW),/fresh questions/);assert.doesNotThrow(()=>applyAction(c,{type:'startAttempt',learnerId:'learner-me',courseId:'programming',mode:'practice',topicId:'values'},NOW));});
test('numeric mastery needs both confidence and at least five responses',()=>{const c=seed();evidence(c,4);assert.equal(mastery(c,'learner-me','values',NOW).visible,false);evidence(c,1);const m=mastery(c,'learner-me','values',NOW);assert.equal(m.count,5);assert.equal(m.visible,true);assert.ok(Math.abs(m.confidence-.4)<1e-10);assert.ok(Math.abs(m.effective-.58)<1e-10);});
test('wrong hard answers add zero to raw mastery; difficulty does not inflate correctness',()=>{const c=seed();evidence(c,8,0);const m=mastery(c,'learner-me','values',NOW);assert.equal(m.raw,0);assert.ok(m.effective<.3);});
test('old evidence decays and can make numeric mastery unavailable',()=>{const c=seed();evidence(c,5);const old=new Date(NOW.getTime()+42*86400000);const m=mastery(c,'learner-me','values',old);assert.equal(m.count,5);assert.ok(m.confidence<.35);assert.equal(m.visible,false);});
test('not-started topics are excluded and in-progress prerequisites gate eligibility',()=>{const c=seed();const [parent,child]=c.courses[0].topics;parent.coverage='NOT_STARTED';child.coverage='IN_PROGRESS';assert.equal(eligible(c,'learner-me',parent,NOW),false);assert.equal(eligible(c,'learner-me',child,NOW),false);evidence(c,10,1,'diagnostic');assert.equal(eligible(c,'learner-me',child,NOW),true);});
test('zero study capacity produces TRIAGE and names every unscheduled eligible topic',()=>{const c=seed();c.learners[0].availability=[];const p=makePlan(c,'learner-me',NOW);assert.equal(p.mode,'TRIAGE');assert.equal(p.slots.length,0);assert.equal(p.unscheduled.length,4);assert.equal(p.deficitHours,p.requiredHours);});
test('cross-subject time is counted once and no two slots overlap',()=>{const c=seed();const p=makePlan(c,'learner-me',NOW);assert.equal(new Set(p.slots.map(s=>s.date+s.time)).size,p.slots.length);assert.ok(p.slots.every(s=>s.date<=c.courses.find(c=>c.id===s.courseId)!.exam));const dates=new Set(p.slots.map(s=>s.date));for(const d of dates)assert.ok(new Set(p.slots.filter(s=>s.date===d).map(s=>s.topicId)).size<=3);assert.equal(p.mode,'NORMAL');});
test('blackouts and recurring class blocks never receive study slots',()=>{const c=seed();c.learners[0].blackouts=['2026-10-13'];c.courses[0].classBlocks=[1*48+36];const p=makePlan(c,'learner-me',NOW);assert.ok(p.slots.every(s=>s.date!=='2026-10-13'));assert.ok(p.slots.every(s=>!(new Date(s.date+'T12:00:00Z').getUTCDay()===2&&s.time==='18:00')));});
test('prerequisite sessions finish before dependent sessions start',()=>{const c=seed();const p=makePlan(c,'learner-me',NOW);const parent=p.slots.filter(s=>s.topicId==='values').at(-1)!;const child=p.slots.find(s=>s.topicId==='loops')!;assert.ok(parent.date+parent.time<child.date+child.time);});
test('an infeasible prerequisite is not silently bypassed for its dependent',()=>{const c=seed();c.learners[0].availability=[36];c.courses[0].topics[0].hours=40;c.courses[0].exam='2026-10-14';const p=makePlan(c,'learner-me',NOW);assert.ok(p.unscheduled.some(s=>s.topicId==='values'));assert.ok(p.unscheduled.some(s=>s.topicId==='loops'));assert.ok(!p.slots.some(s=>s.topicId==='loops'));});
test('completed study slots stay completed after replanning and do not change mastery',()=>{let c=seed();c.plans=[makePlan(c,'learner-me',NOW)];const first=c.plans[0].slots[0];const before=mastery(c,'learner-me',first.topicId,NOW);c=applyAction(c,{type:'completeSlot',learnerId:'learner-me',slotId:first.id,done:true},NOW);c=applyAction(c,{type:'plan',learnerId:'learner-me'},NOW);assert.ok(c.plans[0].slots.some(s=>s.id===first.id&&s.done));assert.deepEqual(mastery(c,'learner-me',first.topicId,NOW),before);});
test('future revision slots consume capacity and are not duplicated',()=>{const c=seed();c.revisionCrossings=[{learnerId:'learner-me',topicId:'values',date:localDate(NOW)}];const p=makePlan(c,'learner-me',NOW);assert.ok(p.slots.some(s=>s.kind==='revise'));assert.equal(new Set(p.slots.map(s=>s.id)).size,p.slots.length);assert.ok(p.requiredHours>makePlan({...c,revisionCrossings:[]},'learner-me',NOW).requiredHours);});
test('Teacher approval gates block a draft course and incomplete question bank',()=>{let c=applyAction(seed(),{type:'addCourse',title:'Real course',code:'R1',teacher:'Teacher',exam:'2026-11-01'},NOW);const id=c.courses.at(-1)!.id;c.learners[0].courseIds.push(id);assert.throws(()=>applyAction(c,{type:'startAttempt',learnerId:'learner-me',courseId:id,mode:'diagnostic'},NOW),/Teacher approval/);c=applyAction(c,{type:'addTopic',courseId:id,title:'Real topic',hours:2,weight:100,notes:'Some useful approved teaching material.',prerequisites:[]},NOW);c=applyAction(c,{type:'approveCurriculum',courseId:id},NOW);assert.throws(()=>applyAction(c,{type:'approveBank',courseId:id},NOW),/Easy, Medium and Hard/);});
test('invalid graph and exam weights cannot be approved',()=>{const c=seed().courses[0];c.topics[0].prerequisites=['loops'];assert.throws(()=>validateGraph(c),/cycle/);c.topics[0].prerequisites=[];c.topics[0].weight=25;assert.throws(()=>validateGraph(c),/total 100/);});
test('editing notes returns both curriculum and question bank to draft',()=>{const c=applyAction(seed(),{type:'editTopic',courseId:'programming',topicId:'values',notes:'Updated teaching material for the first topic.',weight:50,hours:2},NOW);assert.equal(c.courses[0].curriculumApproved,false);assert.equal(c.courses[0].bankApproved,false);assert.throws(()=>courseHelper(c,'learner-me','programming','variables'),/Teacher approval/);});
test('course helper cites only approved assigned notes and refuses unsupported questions',()=>{const c=seed();const found=courseHelper(c,'learner-me','mathematics','determinant');assert.ok(found.results.length);assert.ok(found.results[0].text.includes('determinant'));assert.ok(found.results[0].paragraph>0);assert.equal(courseHelper(c,'learner-me','mathematics','quantum black hole radiation').results.length,0);c.learners[0].courseIds=['programming'];assert.throws(()=>courseHelper(c,'learner-me','mathematics','determinant'),/not assigned/);});
test('invalid dates, questions and availability are rejected without mutating saved state',()=>{const c=seed(),original=JSON.stringify(c);assert.throws(()=>applyAction(c,{type:'editCourse',courseId:'programming',exam:'2026-02-30',classBlocks:[]},NOW),/valid date/);assert.throws(()=>applyAction(c,{type:'availability',learnerId:'learner-me',availability:[336],blackouts:[]},NOW),/Invalid weekly/);assert.throws(()=>applyAction(c,{type:'addQuestion',courseId:'programming',topicId:'values',prompt:'Duplicate choice problem',choices:['x','','y','z'],correct:4,difficulty:'easy',explanation:'An explanation'},NOW));assert.equal(JSON.stringify(c),original);});
test('Teacher-reviewed supportive action is saved to the correct learner profile',()=>{const c=applyAction(seed(),{type:'nudge',learnerId:'learner-me',topicId:'values',message:'Revise expressions for 30 minutes before the checkpoint.'},NOW);assert.equal(c.interventions.length,1);assert.equal(c.interventions[0].learnerId,'learner-me');assert.equal(c.evidence.length,0);});
test('a fresh custom course can be authored, approved, enrolled, assessed and planned',()=>{let c=applyAction(seed(),{type:'addCourse',title:'Custom Algebra',code:'CA1',teacher:'Teacher',exam:'2026-11-01'},NOW);const courseId=c.courses.at(-1)!.id;c=applyAction(c,{type:'addTopic',courseId,title:'Addition',hours:1,weight:100,notes:'Addition combines quantities. For example, 2 + 2 = 4.',prerequisites:[]},NOW);const topicId=c.courses.at(-1)!.topics[0].id;c=applyAction(c,{type:'approveCurriculum',courseId},NOW);for(const difficulty of ['easy','medium','hard'])c=applyAction(c,{type:'addQuestion',courseId,topicId,prompt:`${difficulty}: What is 2 + 2?`,choices:['3','4','5','6'],correct:1,difficulty,explanation:'Two plus two is four.'},NOW);c=applyAction(c,{type:'approveBank',courseId},NOW);c=applyAction(c,{type:'coverage',courseId,topicId,coverage:'COVERED',pin:false},NOW);c=applyAction(c,{type:'enroll',learnerId:'learner-me',courseIds:[courseId]},NOW);c=applyAction(c,{type:'startAttempt',learnerId:'learner-me',courseId,mode:'diagnostic'},NOW);c=answerAll(c);assert.equal(c.evidence.length,3);assert.ok(c.plans[0].slots.some(s=>s.courseId===courseId));});
function d1(){const sql=new DatabaseSync(':memory:');sql.exec(readFileSync(new URL('../drizzle/0000_closed_vin_gonzales.sql',import.meta.url),'utf8'));return {sql,db:{prepare(text:string){return {bind(...args:unknown[]){return {async first(){return sql.prepare(text).get(...args as never[])??null;},async run(){return sql.prepare(text).run(...args as never[]);}};}};}} as unknown as D1Database};}
test('database saves survive reopening and are isolated by authenticated owner ID',async()=>{const {db}=d1();const a=await openCampus(db,'owner-a','A',NOW);a.state.name='Saved campus';await saveCampus(db,'owner-a',a.revision,a.state,NOW);const reopened=await openCampus(db,'owner-a','A',NOW);assert.equal(reopened.state.name,'Saved campus');const other=await openCampus(db,'owner-b','B',NOW);assert.equal(other.state.name,'My learning campus');assert.notEqual(other.state.learners[0].name,reopened.state.learners[0].name);});
test('concurrent-tab revision checks prevent stale writes from overwriting new data',async()=>{const {db}=d1();const first=await openCampus(db,'owner','A',NOW);const stale=await openCampus(db,'owner','A',NOW);first.state.name='Newest';await saveCampus(db,'owner',first.revision,first.state,NOW);stale.state.name='Stale';await assert.rejects(()=>saveCampus(db,'owner',stale.revision,stale.state,NOW),(e:unknown)=>e instanceof ProductError&&e.status===409);assert.equal((await openCampus(db,'owner','A',NOW)).state.name,'Newest');});
