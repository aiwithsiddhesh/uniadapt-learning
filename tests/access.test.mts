import test from 'node:test';
import assert from 'node:assert/strict';
import {DatabaseSync} from 'node:sqlite';
import {readFileSync,readdirSync} from 'node:fs';
import {sampleCampus} from '../lib/sample.ts';
import {openCampus} from '../lib/store.ts';
import {ProductError,questionFor,mastery} from '../lib/engine.ts';
import {authorize,scopedCampus,applyAuthorized,normalizeCampus} from '../lib/access.ts';
import {passwordHash,signSession,authenticate,login,logout,createInvitation,acceptInvitation,tokenHash,checkPassword,sessionCookie} from '../lib/auth.ts';
import type {Account,Principal,AuthConfig} from '../lib/access-types.ts';
import type {Campus} from '../lib/types.ts';
const NOW=new Date('2026-10-13T06:00:00Z');const CONFIG:AuthConfig={secret:'test-only-authentication-secret-with-more-than-32-characters',issuer:'uniadapt-learning'};
const actor=(role:'ADMIN'|'TEACHER'|'STUDENT',id:string,learnerId:string|null=null):Principal=>({role,id,learnerId,campusId:'college',email:id+'@example.org',name:id,courseIds:[],tokenVersion:0});
const admin=actor('ADMIN','admin'),teacher=actor('TEACHER','teacher'),coTeacher=actor('TEACHER','co-teacher'),student=actor('STUDENT','alice','learner-me'),other=actor('STUDENT','bob','learner-bob');
function campus(){const c=normalizeCampus(sampleCampus('Alice',NOW));c.termStart='2026-10-13';c.courses[0].teacherIds=['teacher','co-teacher'];c.courses[0].ownerTeacherId='teacher';c.courses[1].teacherIds=['other-teacher'];c.courses[1].ownerTeacherId='other-teacher';c.learners[0].courseIds=['programming'];c.learners.push({id:'learner-bob',name:'Bob private record',courseIds:['mathematics'],availability:[100],blackouts:['2026-10-20']});return c;}
const forbidden=(fn:()=>unknown)=>assert.throws(fn,(e:unknown)=>e instanceof ProductError&&e.status===403);
function session(c:Campus,supervised=true){return applyAuthorized(c,teacher,{type:'createCheckpoint',courseId:'programming',topicIds:['values'],openAt:new Date(NOW.getTime()-1000).toISOString(),closeAt:new Date(NOW.getTime()+3600000).toISOString(),durationMinutes:30,maxItems:20,supervised},NOW);}
function answerAll(c:Campus,who:Principal){const id=c.attempts.at(-1)!.id;while(c.attempts.find(a=>a.id===id)!.status==='active'){const a=c.attempts.find(a=>a.id===id)!,q=questionFor(c,a)!;c=applyAuthorized(c,who,{type:'answer',attemptId:a.id,questionId:q.id,answer:q.correct},NOW);}return c;}
test('Student cannot create accounts/courses, enroll, approve, teach, or trigger diagnostics',()=>{for(const type of ['addCourse','updateCampus','addLearner','enroll','approveCurriculum','approveBank','coverage','createCheckpoint','createPrerequisite','assignTeachers'])forbidden(()=>authorize(campus(),student,{type,courseId:'programming',learnerId:'learner-me'}));});
test('Teacher cannot use Admin or Student actions',()=>{for(const type of ['addCourse','updateCampus','enroll','addLearner','createPrerequisite','assignTeachers','availability','startAttempt'])forbidden(()=>authorize(campus(),teacher,{type,courseId:'programming',learnerId:'learner-me'}));});
test('Admin cannot approve artifacts or operate a Student/Teacher workspace through API calls',()=>{for(const type of ['approveCurriculum','approveBank','coverage','nudge','answer','availability','startAttempt','createCheckpoint'])forbidden(()=>authorize(campus(),admin,{type,courseId:'programming',learnerId:'learner-me'}));});
test('Student cannot update another Student or answer another Student attempt',()=>{forbidden(()=>authorize(campus(),student,{type:'availability',learnerId:'learner-bob'}));const c=campus();c.attempts.push({id:'bob-attempt',learnerId:'learner-bob',courseId:'mathematics',mode:'practice',status:'active',topicIds:['vectors'],currentTopic:'vectors',currentQuestionId:'vectors-q0',responses:[],startedAt:NOW.toISOString(),expiresAt:new Date(NOW.getTime()+60000).toISOString()});forbidden(()=>authorize(c,student,{type:'answer',attemptId:'bob-attempt',answer:0}));});
test('Teacher cannot read or change unassigned subject data',()=>{const c=campus();forbidden(()=>authorize(c,teacher,{type:'coverage',courseId:'mathematics',topicId:'vectors'}));const view=scopedCampus(c,teacher,NOW);assert.deepEqual(view.courses.map(c=>c.id),['programming']);assert.equal(view.learners.length,1);assert.ok(!JSON.stringify(view).includes('Bob private record'));});
test('CO Teacher may edit assigned material but only Subject Owner can approve it',()=>{assert.doesNotThrow(()=>authorize(campus(),coTeacher,{type:'editTopic',courseId:'programming',topicId:'values'}));forbidden(()=>authorize(campus(),coTeacher,{type:'approveCurriculum',courseId:'programming'}));assert.doesNotThrow(()=>authorize(campus(),teacher,{type:'approveCurriculum',courseId:'programming'}));});
test('Student payload contains only own records and has no direct question bank',()=>{const view=scopedCampus(campus(),student,NOW);assert.deepEqual(view.learners.map(l=>l.id),['learner-me']);assert.equal(view.courses[0].questions.length,0);assert.equal(view.audit.length,0);assert.equal(view.evidence.length,0);assert.ok(!JSON.stringify(view).includes('Bob private record'));assert.ok(!JSON.stringify(view).includes('matrices-q'));});
test('Teacher cannot target a learner/topic outside their teaching scope',()=>{forbidden(()=>authorize(campus(),teacher,{type:'nudge',learnerId:'learner-bob',topicId:'vectors',message:'Private'}));});
test('Student starts only an assigned, open session; cannot create a diagnostic directly',()=>{let c=campus();forbidden(()=>applyAuthorized(c,student,{type:'startAttempt',learnerId:'learner-me',courseId:'programming',mode:'diagnostic'},NOW));c=session(c);const s=c.sessions![0];c=applyAuthorized(c,student,{type:'startAttempt',learnerId:'learner-me',courseId:'programming',mode:'diagnostic',sessionId:s.id},NOW);assert.equal(c.attempts[0].sessionId,s.id);assert.deepEqual(c.attempts[0].topicIds,['values']);forbidden(()=>applyAuthorized(c,other,{type:'startAttempt',learnerId:'learner-bob',courseId:'programming',mode:'diagnostic',sessionId:s.id},NOW));});
test('checkpoint enforces actual coverage and min item capacity before opening',()=>{const c=campus();c.courses[0].topics[0].coverage='NOT_STARTED';assert.throws(()=>session(c),/COVERED or REVISED/);c.courses[0].topics[0].coverage='COVERED';c.courses[0].questions=c.courses[0].questions.filter(q=>q.topicId!=='values'||q.id==='values-q0');assert.throws(()=>session(c),/at least 5/);});
test('session window, supervision weight, and configured topic scope are authoritative',()=>{let c=session(campus(),false);const s=c.sessions![0];assert.throws(()=>applyAuthorized(c,student,{type:'startAttempt',learnerId:'learner-me',courseId:'programming',mode:'diagnostic',sessionId:s.id},new Date(NOW.getTime()+2*3600000)),/not open/);c=applyAuthorized(c,student,{type:'startAttempt',learnerId:'learner-me',courseId:'programming',mode:'diagnostic',sessionId:s.id,sessionTopicIds:['loops'],supervised:true},NOW);c=answerAll(c,student);assert.equal(c.attempts[0].responses.length,6);assert.ok(c.evidence.every(e=>e.topicId==='values'&&e.weight===.8));});
test('Student receives the current question without answer key, rationale or provisional correctness',()=>{let c=session(campus());c=applyAuthorized(c,student,{type:'startAttempt',learnerId:'learner-me',courseId:'programming',mode:'diagnostic',sessionId:c.sessions![0].id},NOW);const view=scopedCampus(c,student,NOW),q=view.courses[0].questions[0];assert.equal(view.courses[0].questions.length,1);assert.ok(!Object.hasOwn(q,'correct'));assert.ok(!Object.hasOwn(q,'explanation'));assert.deepEqual(view.sessions![0].questionIds,[]);});
test('unreleased grades and keys stay hidden until Teacher releases after the session closes',()=>{let c=session(campus());c=applyAuthorized(c,student,{type:'startAttempt',learnerId:'learner-me',courseId:'programming',mode:'diagnostic',sessionId:c.sessions![0].id},NOW);c=answerAll(c,student);const view=scopedCampus(c,student,NOW);assert.equal(view.attempts[0].feedbackReleased,false);assert.ok(view.attempts[0].responses.every(r=>!Object.hasOwn(r,'correct')));assert.equal(view.courses[0].questions.length,0);assert.throws(()=>applyAuthorized(c,teacher,{type:'releaseFeedback',sessionId:c.sessions![0].id},NOW),/window closes/);c=applyAuthorized(c,teacher,{type:'releaseFeedback',sessionId:c.sessions![0].id},new Date(NOW.getTime()+2*3600000));const released=scopedCampus(c,student,NOW);assert.equal(released.attempts[0].feedbackReleased,true);assert.ok(released.courses[0].questions.every(q=>Object.hasOwn(q,'correct')));});
test('replacement drafts preserve active notes until Subject Owner approval',()=>{const c=campus(),old=c.courses[0].topics[0].notes;let next=applyAuthorized(c,coTeacher,{type:'editTopic',courseId:'programming',topicId:'values',notes:'DRAFT SECRET NEW CONTENT for review.',weight:50,hours:2},NOW);assert.equal(next.courses[0].topics[0].notes,old);assert.equal(next.courses[0].curriculumApproved,true);assert.ok(next.courses[0].draftTopics);assert.ok(!JSON.stringify(scopedCampus(next,student,NOW)).includes('DRAFT SECRET'));assert.ok(JSON.stringify(scopedCampus(next,teacher,NOW)).includes('DRAFT SECRET'));next=applyAuthorized(next,teacher,{type:'approveCurriculum',courseId:'programming'},NOW);assert.match(next.courses[0].topics[0].notes,/DRAFT SECRET/);assert.ok(next.courses[0].artifactHistory?.length);assert.ok(!JSON.stringify(scopedCampus(next,student,NOW)).includes('artifactHistory'));});
test('Student cannot discover draft-bank keys in nested version data',()=>{const c=campus();c.courses[0].draftQuestions=[{...c.courses[0].questions[0],prompt:'HIDDEN DRAFT QUESTION'}];c.courses[0].artifactHistory=[{id:'old',date:NOW.toISOString(),approvedBy:'teacher',topics:[],questions:[{...c.courses[0].questions[0],prompt:'HIDDEN HISTORICAL BANK'}]}];const json=JSON.stringify(scopedCampus(c,student,NOW));assert.ok(!json.includes('HIDDEN DRAFT'));assert.ok(!json.includes('HIDDEN HISTORICAL'));});
test('Admin prerequisite diagnostic is limited to semester-start dates and one session per offering',()=>{let c=campus();const action={type:'createPrerequisite',courseId:'programming',topicIds:['values'],openAt:NOW.toISOString(),closeAt:new Date(NOW.getTime()+3600000).toISOString(),durationMinutes:30,maxItems:20,supervised:true};c=applyAuthorized(c,admin,action,NOW);assert.equal(c.sessions![0].kind,'PREREQ');assert.throws(()=>applyAuthorized(c,admin,action,NOW),/already has/);assert.throws(()=>applyAuthorized(campus(),admin,action,new Date(NOW.getTime()+14*86400000)),/first 14/);});
function d1(){const sql=new DatabaseSync(':memory:');for(const file of readdirSync(new URL('../drizzle',import.meta.url)).filter(f=>f.endsWith('.sql')).sort())sql.exec(readFileSync(new URL('../drizzle/'+file,import.meta.url),'utf8'));function prepared(text:string,args:unknown[]=[]){return {bind(...values:unknown[]){return prepared(text,values);},async first(){return sql.prepare(text).get(...args as never[])??null;},async run(){const result=sql.prepare(text).run(...args as never[]);return {meta:{changes:result.changes},success:true};},async all(){return {results:sql.prepare(text).all(...args as never[])};},_run(){const s=sql.prepare(text);if(text.includes('RETURNING'))return {results:s.all(...args as never[]),success:true};const r=s.run(...args as never[]);return {results:[],meta:{changes:r.changes},success:true};}};}const db={prepare:prepared,async batch(statements:ReturnType<typeof prepared>[]){sql.exec('BEGIN');try{const result=statements.map(s=>s._run());sql.exec('COMMIT');return result;}catch(e){sql.exec('ROLLBACK');throw e;}}} as unknown as D1Database;return {db,sql};}
async function fixture(){const {db,sql}=d1();await openCampus(db,'college','Administrator',NOW);await db.prepare('INSERT INTO institutions (id,campus_id,created_by,created_at) VALUES (?,?,?,?)').bind('default','college','site-owner',NOW.toISOString()).run();const hash=await passwordHash('Test password 1234');const records:Account[]=[{id:'admin',campus_id:'college',name:'Administrator',email:'admin@example.org',role:'ADMIN',password_hash:hash,active:1,token_version:0,learner_id:null,course_ids:'[]',created_at:NOW.toISOString()},{id:'teacher',campus_id:'college',name:'Teacher',email:'teacher@example.org',role:'TEACHER',password_hash:hash,active:1,token_version:0,learner_id:null,course_ids:'[]',created_at:NOW.toISOString()},{id:'student',campus_id:'college',name:'Student',email:'student@example.org',role:'STUDENT',password_hash:hash,active:1,token_version:0,learner_id:'learner-me',course_ids:'[]',created_at:NOW.toISOString()}];for(const a of records)await db.prepare('INSERT INTO accounts (id,campus_id,email,name,role,password_hash,active,token_version,learner_id,course_ids,created_at) VALUES (?,?,?,?,?,?,?,?,?,?,?)').bind(a.id,a.campus_id,a.email,a.name,a.role,a.password_hash,a.active,a.token_version,a.learner_id,a.course_ids,a.created_at).run();return {db,sql,records};}
test('bcrypt credentials issue one-role JWTs which expire at exactly four hours',async()=>{const {db,records}=await fixture();assert.ok(records[0].password_hash!.startsWith('$2'));const result=await login(db,'STUDENT@example.org','Test password 1234',CONFIG,'ip1',NOW);assert.equal(result.user.role,'STUDENT');assert.equal((await authenticate(db,result.token,CONFIG,new Date(NOW.getTime()+14399*1000))).id,'student');await assert.rejects(()=>authenticate(db,result.token,CONFIG,new Date(NOW.getTime()+14400*1000)),(e:unknown)=>e instanceof ProductError&&e.status===401);assert.match(sessionCookie(result.token),/HttpOnly; Secure; SameSite=Strict; Max-Age=14400/);});
test('forged signature, wrong signing key and changed role are rejected',async()=>{const {db,records}=await fixture();const token=await signSession(records[2],CONFIG,NOW);const parts=token.split('.');parts[1]=Buffer.from(JSON.stringify({sub:'student',role:'ADMIN'})).toString('base64url');await assert.rejects(()=>authenticate(db,parts.join('.'),CONFIG,NOW));await assert.rejects(()=>authenticate(db,token,{...CONFIG,secret:CONFIG.secret+'wrong'},NOW));await db.prepare("UPDATE accounts SET role='TEACHER' WHERE id='student'").run();await assert.rejects(()=>authenticate(db,token,CONFIG,NOW));});
test('logout and deactivation immediately revoke previously issued sessions',async()=>{const {db,records}=await fixture();const token=await signSession(records[1],CONFIG,NOW);const user=await authenticate(db,token,CONFIG,NOW);await logout(db,user,NOW);await assert.rejects(()=>authenticate(db,token,CONFIG,NOW));const row=await db.prepare("SELECT * FROM accounts WHERE id='student'").first<Account>();const studentToken=await signSession(row!,CONFIG,NOW);await db.prepare("UPDATE accounts SET active=0,token_version=token_version+1 WHERE id='student'").run();await assert.rejects(()=>authenticate(db,studentToken,CONFIG,NOW));await assert.rejects(()=>login(db,'student@example.org','Test password 1234',CONFIG,'ip2',NOW),/Invalid email or password/);});
test('single-use setup/reset links store only hashes, expire and revoke old sessions',async()=>{const {db,records}=await fixture();const old=await signSession(records[2],CONFIG,NOW);const link=await createInvitation(db,admin,'student','reset',NOW);const saved=await db.prepare('SELECT * FROM auth_tokens').first<Record<string,unknown>>();assert.equal(saved!.hash,await tokenHash(link.token));assert.ok(!JSON.stringify(saved).includes(link.token));const accepted=await acceptInvitation(db,link.token,'Changed password 1234',CONFIG,'ip3',NOW);assert.equal(accepted.user.role,'STUDENT');await assert.rejects(()=>acceptInvitation(db,link.token,'Changed password 1234',CONFIG,'ip3',NOW),/invalid or expired/);await assert.rejects(()=>authenticate(db,old,CONFIG,NOW));const expired=await createInvitation(db,admin,'student','reset',NOW);await assert.rejects(()=>acceptInvitation(db,expired.token,'Another password 1234',CONFIG,'ip3',new Date(NOW.getTime()+24*3600000)),/invalid or expired/);});
test('replacement setup links invalidate earlier tokens, and non-Admins cannot create them',async()=>{const {db}=await fixture();const first=await createInvitation(db,admin,'student','reset',NOW);const second=await createInvitation(db,admin,'student','reset',NOW);await assert.rejects(()=>acceptInvitation(db,first.token,'A strong password 1234',CONFIG,'ip4',NOW),/invalid or expired/);assert.ok(second.token!==first.token);await assert.rejects(()=>createInvitation(db,teacher,'student','reset',NOW),(e:unknown)=>e instanceof ProductError&&e.status===403);});
test('failed login throttling is generic for existing and nonexistent identities',async()=>{const {db}=await fixture();for(let i=0;i<5;i++)await assert.rejects(()=>login(db,'teacher@example.org','wrong password',CONFIG,'ip5',NOW),/Invalid email or password/);await assert.rejects(()=>login(db,'teacher@example.org','Test password 1234',CONFIG,'ip5',NOW),(e:unknown)=>e instanceof ProductError&&e.status===429);await assert.rejects(()=>login(db,'unknown@example.org','wrong password',CONFIG,'ip6',NOW),/Invalid email or password/);});
test('password validation rejects excessive UTF-8 bytes rather than silently truncating',()=>{assert.throws(()=>checkPassword('short'));assert.throws(()=>checkPassword('😀'.repeat(20)));assert.doesNotThrow(()=>checkPassword('A strong password 1234'));});
test('SQL constrains each account to exactly one allowed role and a unique linked Student',async()=>{const {db}=await fixture();await assert.rejects(()=>db.prepare("UPDATE accounts SET role='OWNER' WHERE id='teacher'").run());await assert.rejects(()=>db.prepare("UPDATE accounts SET learner_id='learner-me' WHERE id='teacher'").run());});
