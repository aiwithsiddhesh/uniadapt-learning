import {DatabaseSync} from 'node:sqlite';
import {readFileSync,readdirSync} from 'node:fs';
import {openCampus} from '../lib/store.ts';
import {runAcademic} from '../lib/academic-store.ts';
import type {Principal} from '../lib/access-types.ts';
import type {AcademicAction,AcademicData} from '../lib/academic-types.ts';
export const NOW=new Date('2026-10-13T06:00:00Z');
export const admin:Principal={id:'admin',campusId:'college',role:'ADMIN',name:'Administrator',email:'admin@example.invalid',learnerId:null,courseIds:[],tokenVersion:0};
export function database(){const sql=new DatabaseSync(':memory:');sql.exec('PRAGMA foreign_keys = ON');for(const name of readdirSync(new URL('../drizzle',import.meta.url)).filter(n=>n.endsWith('.sql')).sort())sql.exec(readFileSync(new URL('../drizzle/'+name,import.meta.url),'utf8'));function prepare(query:string,args:unknown[]=[]){return {bind(...values:unknown[]){return prepare(query,values);},async first(){return sql.prepare(query).get(...args as never[])??null;},async all(){return {results:sql.prepare(query).all(...args as never[])};},async run(){const r=sql.prepare(query).run(...args as never[]);return {results:[],meta:{changes:r.changes},success:true};},execute(){const statement=sql.prepare(query);if(/RETURNING|^SELECT/i.test(query))return {results:statement.all(...args as never[]),success:true};const r=statement.run(...args as never[]);return {results:[],meta:{changes:r.changes},success:true};}};}const db={prepare,async batch(statements:ReturnType<typeof prepare>[]){sql.exec('BEGIN IMMEDIATE');try{const rows=statements.map(s=>s.execute());sql.exec('COMMIT');return rows;}catch(e){sql.exec('ROLLBACK');throw e;}}} as unknown as D1Database;return {db,sql};}
export async function setup(){const {db,sql}=database();await openCampus(db,'college','Student',NOW);await db.prepare('INSERT INTO institutions (id,campus_id,created_by,created_at) VALUES (?,?,?,?)').bind('default','college','admin',NOW.toISOString()).run();for(const [id,role,learner] of [['admin','ADMIN',null],['teacher','TEACHER',null],['co','TEACHER',null],['student','STUDENT','learner-me']] as const)await db.prepare('INSERT INTO accounts (id,campus_id,email,name,role,active,learner_id,created_at) VALUES (?,?,?,?,?,1,?,?)').bind(id,'college',id+'@example.invalid',id,role,learner,NOW.toISOString()).run();let revision=0;let data:AcademicData;
 const act=async(action:AcademicAction)=>{const r=await runAcademic(db,admin,revision,action,NOW);revision=r.revision;if('academic' in r&&r.academic)data=r.academic;return r;};
 await act({type:'saveDepartment',code:'ENG',name:'Engineering'});await act({type:'saveProgram',departmentId:data!.departments[0].id,code:'BE',name:'Engineering degree',durationSemesters:8});await act({type:'saveBatch',programId:data!.programs[0].id,code:'2026',startYear:2026,endYear:2030});await act({type:'saveSemester',batchId:data!.batches[0].id,number:1,startDate:'2026-10-01',endDate:'2027-02-01'});for(const name of ['A','B'])await act({type:'saveSection',semesterId:data!.semesters[0].id,name,capacity:2000});await act({type:'saveSubject',programId:data!.programs[0].id,semesterNo:1,code:'CS1',name:'Computing',credits:3,subjectType:'CORE_THEORY',sourceCourseId:'programming',units:[{name:'Unit 1',weight:100}]});for(const section of data!.sections)await act({type:'saveOffering',subjectId:data!.subjects[0].id,sectionId:section.id,exam:'2027-01-20',capacity:2000,status:'ACTIVE',teacherIds:['teacher','co'],primaryTeacherId:'teacher',ownerTeacherId:'teacher'});
 return {db,sql,get data(){return data;},get revision(){return revision;},act};
}
