import type {AcademicAction,AcademicData,PlacementPreview} from '../lib/academic-types.ts';
import type {Campus} from '../lib/types.ts';
import type {Principal} from '../lib/access-types.ts';
const NOW=new Date('2026-10-13T06:00:00Z');
const admin:Principal={id:'admin',campusId:'college',role:'ADMIN',name:'Admin',email:'admin@example.invalid',learnerId:null,courseIds:[],tokenVersion:0};
const teachers=[{id:'teacher',name:'Primary Teacher',active:1},{id:'co',name:'Co Teacher',active:1},{id:'other',name:'Section B Teacher',active:1}];
type Fixture={data:AcademicData;campus:Campus};
async function change(f:Fixture,action:AcademicAction){return applyAcademic(f.data,f.campus,admin,action,1,crypto.randomUUID(),teachers,NOW);}
async function foundation():Promise<Fixture>{let f={campus:sampleCampus('Alice',NOW),data:emptyAcademic('college',sampleCampus('Alice',NOW))};
 for(const get of [()=>({type:'saveDepartment',code:'ENG',name:'Engineering'}),()=>({type:'saveProgram',departmentId:f.data.departments[0].id,code:'BTECH',name:'BTech',durationSemesters:8}),()=>({type:'saveBatch',programId:f.data.programs[0].id,code:'2026',startYear:2026,endYear:2030}),()=>({type:'saveSemester',batchId:f.data.batches[0].id,number:1,startDate:'2026-10-01',endDate:'2027-02-01'}),()=>({type:'saveSection',semesterId:f.data.semesters[0].id,name:'A',capacity:2}),()=>({type:'saveSection',semesterId:f.data.semesters[0].id,name:'B',capacity:2})])f=await change(f,get() as AcademicAction);
 return f;
}
async function subject(f:Fixture,overrides:Record<string,unknown>={}){return change(f,{type:'saveSubject',programId:f.data.programs[0].id,semesterNo:1,code:'CS101',name:'Computing',credits:3,subjectType:'CORE_THEORY',units:[{name:'Unit 1',weight:100}],sourceCourseId:'programming',...overrides});}
async function offering(f:Fixture,section=0,subjectIndex=0,overrides:Record<string,unknown>={}){return change(f,{type:'saveOffering',subjectId:f.data.subjects[subjectIndex].id,sectionId:f.data.sections[section].id,exam:'2027-01-20',capacity:2,status:'ACTIVE',primaryTeacherId:section===0?'teacher':'other',teacherIds:section===0?['teacher','co']:['other'],ownerTeacherId:'teacher',...overrides});}
async function ready(){return offering(await subject(await foundation()));}
const placement=(f:Fixture,learnerId='learner-me',section=0,extra:Record<string,unknown>={}):AcademicAction=>({type:'previewPlacement',learnerId,sectionId:f.data.sections[section].id,rollNo:learnerId.toUpperCase(),electiveSubjectIds:[],...extra});
async function place(f:Fixture,action=placement(f)){const p=await previewPlacement(f.data,f.campus,admin,action,1);return change(f,{...action,type:'confirmPlacement',previewHash:p.hash});}
test('hierarchy keeps valid parent paths, scoped uniqueness and term ranges',async()=>{const f=await foundation();assert.equal(sectionPath(f.data,f.data.sections[0].id).program.code,'BTECH');await assert.rejects(()=>change(f,{type:'saveSection',semesterId:'elsewhere',name:'X',capacity:2}),/not found/);await assert.rejects(()=>change(f,{type:'saveSection',semesterId:f.data.semesters[0].id,name:'a',capacity:2}),/already exists/);await assert.rejects(()=>change(f,{type:'saveSemester',batchId:f.data.batches[0].id,number:9,startDate:'2026-09-01',endDate:'2027-01-01'}),/Semester number/);await assert.rejects(()=>change(f,{type:'saveSemester',batchId:f.data.batches[0].id,number:2,startDate:'2027-01-01',endDate:'2027-04-01'}),/overlap/);await assert.rejects(()=>change(f,{type:'saveBatch',programId:f.data.programs[0].id,code:'bad',startYear:2026,endYear:2025}),/End year/);});
test('deactivation and edits preserve dependent academic records',async()=>{const f=await foundation();await assert.rejects(()=>change(f,{type:'saveDepartment',id:f.data.departments[0].id,code:'ENG',name:'Engineering',active:false}),/Programs first/);await assert.rejects(()=>change(f,{type:'saveProgram',id:f.data.programs[0].id,departmentId:f.data.departments[0].id,code:'BTECH',name:'BTech',durationSemesters:0}),/duration/);const next=await change(f,{type:'saveSection',id:f.data.sections[1].id,semesterId:f.data.semesters[0].id,name:'B',capacity:2,active:false});assert.equal(next.data.sections[1].active,false);assert.equal(f.data.sections[1].active,true);});
test('catalogue validates exact Unit weight sum, type and Program semester scope',async()=>{const f=await foundation();await assert.rejects(()=>subject(f,{units:[{name:'U1',weight:60},{name:'U2',weight:30}]}),/exactly 100/);await assert.rejects(()=>subject(f,{subjectType:'OTHER'}),/supported/);await assert.rejects(()=>subject(f,{semesterNo:9}),/semester/);await assert.rejects(()=>subject(f,{subjectType:'ELECTIVE',group:''}),/elective group/);const next=await subject(f,{units:[{name:'U1',weight:40.5},{name:'U2',weight:59.5}]});assert.equal(next.data.subjects[0].units.length,2);const base=next.campus.courses.find(c=>c.id===next.data.subjects[0].contentCourseId)!;assert.equal(base.curriculumApproved,false);assert.ok(base.questions.every(q=>!f.campus.courses[0].questions.some(old=>old.id===q.id)));assert.ok(base.topics.every(t=>!f.campus.courses[0].topics.some(old=>old.id===t.id)));});
test('active offerings enforce PRIMARY Teacher, owner, exact exam and matching Section',async()=>{const f=await subject(await foundation());await assert.rejects(()=>offering(f,0,0,{primaryTeacherId:null}),/PRIMARY/);await assert.rejects(()=>offering(f,0,0,{ownerTeacherId:'co'}),/Subject Owner/);await assert.rejects(()=>offering(f,0,0,{teacherIds:['not-teacher']}),/valid Teacher/);await assert.rejects(()=>offering(f,0,0,{exam:'2027-03-20'}),/inside this Semester/);await assert.rejects(()=>offering(f,0,0,{capacity:3}),/capacity/);const draft=await offering(f,0,0,{status:'DRAFT',teacherIds:[],primaryTeacherId:null,ownerTeacherId:null});assert.equal(draft.data.offerings[0].status,'DRAFT');await assert.rejects(()=>previewPlacement(draft.data,draft.campus,admin,placement(draft),1),/ACTIVE offering/);});
test('placement preview is exact, mandatory, revision-specific, and does not mutate data',async()=>{const f=await ready(),a=placement(f),before=JSON.stringify(f);const p=await previewPlacement(f.data,f.campus,admin,a,1);assert.equal(JSON.stringify(f),before);assert.equal(p.added.length,1);assert.equal(p.removed.length,2);await assert.rejects(()=>change(f,{...a,type:'confirmPlacement'}),/Preview this exact/);await assert.rejects(()=>applyAcademic(f.data,f.campus,admin,{...a,type:'confirmPlacement',previewHash:p.hash},2,'op',teachers,NOW),/Preview this exact/);const placed=await place(f,a);assert.deepEqual(placed.campus.learners[0].courseIds,[placed.data.offerings[0].courseId]);assert.equal(placed.data.enrollments[0].autoAllocated,true);assert.equal(placed.data.history.length,1);});
test('enrollment refresh and repeated confirmation never duplicate active enrollment/history',async()=>{let f=await place(await ready());const count=f.data.enrollments.length;f=await change(f,{type:'refreshEnrollment'});f=await place(f);assert.equal(f.data.enrollments.length,count);assert.equal(f.data.history.length,1);});
test('section and offering capacity reject overflow without partial placement',async()=>{let f=await place(await ready());f.campus.learners.push({id:'second',name:'Second',courseIds:[],availability:[],blackouts:[]},{id:'third',name:'Third',courseIds:[],availability:[],blackouts:[]});f=await place(f,placement(f,'second'));const before=JSON.stringify(f);await assert.rejects(()=>previewPlacement(f.data,f.campus,admin,placement(f,'third'),1),/capacity is full/);assert.equal(JSON.stringify(f),before);await assert.rejects(()=>change(f,{type:'saveSection',id:f.data.sections[0].id,semesterId:f.data.semesters[0].id,name:'A',capacity:1}),/Capacity cannot/);});
test('required elective groups allocate exactly one eligible Subject with capacity',async()=>{let f=await ready();f=await subject(f,{code:'EL1',name:'Elective one',subjectType:'ELECTIVE',group:'Open',groupRequired:true});f=await subject(f,{code:'EL2',name:'Elective two',subjectType:'ELECTIVE',group:'Open',groupRequired:true});f=await offering(f,0,1);f=await offering(f,0,2);await assert.rejects(()=>previewPlacement(f.data,f.campus,admin,placement(f),1),/exactly one elective/);await assert.rejects(()=>previewPlacement(f.data,f.campus,admin,placement(f,'learner-me',0,{electiveSubjectIds:f.data.subjects.slice(1).map(s=>s.id)}),1),/only one elective/);f=await place(f,placement(f,'learner-me',0,{electiveSubjectIds:[f.data.subjects[2].id]}));assert.equal(f.campus.learners[0].courseIds.length,2);assert.ok(f.data.enrollments.every(e=>e.status==='ACTIVE'));});
test('transfer closes prior enrollments and preserves attempts, evidence and placement history',async()=>{let f=await place(await ready());f=await offering(f,1);const old=f.data.offerings[0].courseId;f.campus.evidence.push({id:'e',learnerId:'learner-me',courseId:old,topicId:'topic',questionId:'q',correctness:1,source:'practice',difficulty:'easy',date:NOW.toISOString(),attemptId:'a'});f=await place(f,placement(f,'learner-me',1));assert.equal(f.data.enrollments.filter(e=>e.status==='CLOSED').length,1);assert.equal(f.data.enrollments.filter(e=>e.status==='ACTIVE').length,1);assert.equal(f.data.history.length,2);assert.equal(f.data.history[1].fromSectionId,f.data.sections[0].id);assert.equal(f.campus.evidence.length,1);assert.ok(f.campus.learners[0].historicalCourseIds?.includes(old));});
test('duplicate rolls, active-attempt transfer and empty curricula assignment failures are explicit',async()=>{let f=await place(await ready());f=await offering(f,1);f.campus.learners.push({id:'bob',name:'Bob',courseIds:[],availability:[],blackouts:[]});await assert.rejects(()=>previewPlacement(f.data,f.campus,admin,placement(f,'bob',0,{rollNo:'LEARNER-ME'}),1),/Roll number/);f.campus.attempts.push({id:'active',learnerId:'learner-me',courseId:f.data.offerings[0].courseId,mode:'practice',status:'active',topicIds:[],currentTopic:'',currentQuestionId:'',responses:[],startedAt:NOW.toISOString(),expiresAt:new Date(NOW.getTime()+60000).toISOString()});await assert.rejects(()=>previewPlacement(f.data,f.campus,admin,placement(f,'learner-me',1),1),/active assessment/);});
test('manual Admin endpoints cannot bypass normalized placement/assignments/date validation',async()=>{const f=await place(await ready()),id=f.data.offerings[0].courseId;for(const action of [{type:'enroll',learnerId:'learner-me',courseIds:[]},{type:'addLearner',name:'X',courseIds:[id]},{type:'assignTeachers',courseId:id},{type:'editCourse',courseId:id,exam:'2030-01-01'}])assert.throws(()=>authorize(f.campus,admin,action),(e:unknown)=>e instanceof ProductError&&e.status===403);});
test('Student and Teacher cannot manage academic structure or access another institution',async()=>{const f=await foundation();for(const role of ['STUDENT','TEACHER'] as const)await assert.rejects(()=>applyAcademic(f.data,f.campus,{...admin,role},{type:'saveDepartment',code:'X',name:'X'},1,'op',teachers,NOW),(e:unknown)=>e instanceof ProductError&&e.status===403);assert.throws(()=>requireAcademicAdmin({...admin,campusId:'different'},'college'),(e:unknown)=>e instanceof ProductError&&e.status===403);});
test('shared material activation propagates across sections while actual coverage and pins stay separate',async()=>{let f=await ready();f=await offering(f,1);const a=f.data.offerings[0].courseId,b=f.data.offerings[1].courseId,topic=f.campus.courses.find(c=>c.id===a)!.topics[0].id;const teacher={...admin,id:'teacher',role:'TEACHER' as const};f.campus=applyAuthorized(f.campus,teacher,{type:'approveCurriculum',courseId:a},NOW);assert.equal(f.campus.courses.find(c=>c.id===b)!.curriculumApproved,true);f.campus=applyAuthorized(f.campus,teacher,{type:'coverage',courseId:a,topicId:topic,coverage:'COVERED',pin:true},NOW);assert.equal(f.campus.courses.find(c=>c.id===b)!.topics[0].coverage,'NOT_STARTED');f.campus=applyAuthorized(f.campus,teacher,{type:'editTopic',courseId:a,topicId:topic,notes:'New notes for shared curriculum approval.',hours:1,weight:50},NOW);assert.ok(f.campus.courses.find(c=>c.id===b)!.draftTopics);f.campus=applyAuthorized(f.campus,teacher,{type:'approveCurriculum',courseId:a},NOW);assert.equal(f.campus.courses.find(c=>c.id===b)!.topics[0].notes,'New notes for shared curriculum approval.');assert.equal(f.campus.courses.find(c=>c.id===a)!.topics[0].coverage,'COVERED');assert.equal(f.campus.courses.find(c=>c.id===b)!.topics[0].coverage,'NOT_STARTED');assert.equal(scopedCampus(f.campus,teacher,NOW).courses.length,1);});
test('Core Lab remains enrolled but is excluded from adaptive study planning',async()=>{let f=await subject(await foundation(),{subjectType:'CORE_LAB'});f=await place(await offering(f));const c=f.campus.courses.find(c=>c.id===f.data.offerings[0].courseId)!;c.curriculumApproved=c.bankApproved=true;c.topics.forEach(t=>t.coverage='COVERED');assert.equal(makePlan(f.campus,'learner-me',NOW).slots.length,0);});
function database(){const sql=new DatabaseSync(':memory:');sql.exec('PRAGMA foreign_keys=ON');for(const file of readdirSync(new URL('../drizzle',import.meta.url)).filter(f=>f.endsWith('.sql')).sort())sql.exec(readFileSync(new URL('../drizzle/'+file,import.meta.url),'utf8'));function prepare(query:string,args:unknown[]=[]){return {bind(...values:unknown[]){return prepare(query,values);},async first(){return sql.prepare(query).get(...args as never[])??null;},async all(){return {results:sql.prepare(query).all(...args as never[])};},async run(){const r=sql.prepare(query).run(...args as never[]);return {meta:{changes:r.changes},results:[],success:true};},execute(){if(/RETURNING|^SELECT/i.test(query))return {results:sql.prepare(query).all(...args as never[]),success:true};const r=sql.prepare(query).run(...args as never[]);return {results:[],meta:{changes:r.changes},success:true};}};}const db={prepare,async batch(statements:ReturnType<typeof prepare>[]){sql.exec('BEGIN IMMEDIATE');try{const rows=statements.map(s=>s.execute());sql.exec('COMMIT');return rows;}catch(e){sql.exec('ROLLBACK');throw e;}}} as unknown as D1Database;return {db,sql};}
async function storedFixture(){const {db,sql}=database();await openCampus(db,'college','Alice',NOW);for(const teacher of teachers)await db.prepare('INSERT INTO accounts (id,campus_id,email,name,role,active,created_at) VALUES (?,?,?,?,?,?,?)').bind(teacher.id,'college',teacher.id+'@example.invalid',teacher.name,'TEACHER',1,NOW.toISOString()).run();return {db,sql};}
test('real SQLite round trip persists normalized hierarchy with referential constraints',async()=>{const {db,sql}=await storedFixture();let revision=0;let result=await runAcademic(db,admin,revision,{type:'saveDepartment',code:'ENG',name:'Engineering'},NOW);revision=result.revision;const row=(result as {academic:AcademicData}).academic.departments[0];result=await runAcademic(db,admin,revision,{type:'saveProgram',departmentId:row.id,code:'BE',name:'Engineering',durationSemesters:8},NOW);const stored=await openCampus(db,'college','Alice',NOW),data=await readAcademic(db,'college',stored.state);assert.equal(data.programs[0].departmentId,row.id);assert.equal(stored.revision,2);assert.equal(sql.prepare('SELECT count(*) AS n FROM academic_operations').get()!.n,2);assert.throws(()=>sql.prepare("INSERT INTO academic_sections (id,campus_id,semester_id,name,capacity,active) VALUES ('bad','college','missing','X',2,1)").run(),/FOREIGN KEY/);assert.throws(()=>sql.prepare("INSERT INTO academic_departments (id,campus_id,code,name,active) VALUES ('dup','college','ENG','Duplicate',1)").run(),/UNIQUE/);});
test('stale writers and failing transactions leave both academic and campus records unchanged',async()=>{const {db,sql}=await storedFixture();await runAcademic(db,admin,0,{type:'saveDepartment',code:'ENG',name:'Engineering'},NOW);const before=JSON.stringify(sql.prepare('SELECT * FROM campuses').all());await assert.rejects(()=>runAcademic(db,admin,0,{type:'saveDepartment',code:'STALE',name:'Stale'},NOW),(e:unknown)=>e instanceof ProductError&&e.status===409);assert.equal(sql.prepare('SELECT count(*) AS n FROM academic_departments').get()!.n,1);sql.exec("CREATE TRIGGER academic_fail BEFORE INSERT ON academic_departments WHEN NEW.code='FAIL' BEGIN SELECT RAISE(ABORT,'intentional failure'); END");await assert.rejects(()=>runAcademic(db,admin,1,{type:'saveDepartment',code:'FAIL',name:'Rejected'},NOW),/intentional failure/);assert.equal(JSON.stringify(sql.prepare('SELECT * FROM campuses').all()),before);assert.equal(sql.prepare('SELECT count(*) AS n FROM academic_operations').get()!.n,1);});
test('the transactional operation guard blocks a race after validation and before commit',async()=>{const {db,sql}=await storedFixture(),stored=await openCampus(db,'college','Alice',NOW),before=emptyAcademic('college',stored.state),action:AcademicAction={type:'saveDepartment',code:'RACE',name:'Raced'};const next=await applyAcademic(before,stored.state,admin,action,0,'raced-operation',teachers,NOW);sql.prepare('UPDATE campuses SET revision = 1 WHERE owner_id = ?').run('college');await assert.rejects(()=>commitAcademic(db,admin,0,before,next.data,next.campus,action,'raced-operation',NOW),(e:unknown)=>e instanceof ProductError&&e.status===409);assert.equal(sql.prepare('SELECT count(*) AS n FROM academic_departments').get()!.n,0);assert.equal(sql.prepare('SELECT count(*) AS n FROM academic_operations').get()!.n,0);assert.equal(sql.prepare('SELECT revision FROM campuses').get()!.revision,1);});
test('full database enrollment and transfer round trip survives reload with closed history intact',async()=>{const {db,sql}=await storedFixture();let revision=0,data=emptyAcademic('college',(await openCampus(db,'college','Alice',NOW)).state);const action=async(a:AcademicAction)=>{const result=await runAcademic(db,admin,revision,a,NOW);revision=result.revision;if('academic' in result&&result.academic)data=result.academic;return result;};
 await action({type:'saveDepartment',code:'ENG',name:'Engineering'});await action({type:'saveProgram',departmentId:data.departments[0].id,code:'BE',name:'BE',durationSemesters:8});await action({type:'saveBatch',programId:data.programs[0].id,code:'2026',startYear:2026,endYear:2030});await action({type:'saveSemester',batchId:data.batches[0].id,number:1,startDate:'2026-10-01',endDate:'2027-02-01'});for(const name of ['A','B'])await action({type:'saveSection',semesterId:data.semesters[0].id,name,capacity:2});await action({type:'saveSubject',programId:data.programs[0].id,semesterNo:1,code:'CS1',name:'Computing',credits:3.5,subjectType:'CORE_THEORY',units:[{name:'Unit 1',weight:40.5},{name:'Unit 2',weight:59.5}],sourceCourseId:'programming'});for(const section of data.sections)await action({type:'saveOffering',subjectId:data.subjects[0].id,sectionId:section.id,exam:'2027-01-20',capacity:2,status:'ACTIVE',primaryTeacherId:'teacher',teacherIds:['teacher','co'],ownerTeacherId:'teacher'});
 for(const section of data.sections){const a:AcademicAction={type:'previewPlacement',learnerId:'learner-me',rollNo:'CS-001',sectionId:section.id,electiveSubjectIds:[]},preview=await action(a) as {preview:PlacementPreview};await action({...a,type:'confirmPlacement',previewHash:preview.preview.hash});}
 const stored=await openCampus(db,'college','Alice',NOW),reload=await readAcademic(db,'college',stored.state);assert.equal(reload.subjects[0].credits,3.5);assert.equal(reload.subjects[0].units[1].weight,59.5);assert.equal(reload.offerings[1].primaryTeacherId,'teacher');assert.deepEqual(reload.offerings[1].teacherIds,['teacher','co']);assert.equal(reload.enrollments.filter(e=>e.status==='CLOSED').length,1);assert.equal(reload.enrollments.filter(e=>e.status==='ACTIVE').length,1);assert.equal(reload.history.length,2);assert.equal(stored.state.learners[0].sectionId,data.sections[1].id);assert.deepEqual(stored.state.learners[0].courseIds,[data.offerings[1].courseId]);assert.equal(sql.prepare('SELECT auto_allocated FROM academic_enrollments LIMIT 1').get()!.auto_allocated,1);
 await action({type:'refreshEnrollment'});const refreshed=await readAcademic(db,'college',(await openCampus(db,'college','Alice',NOW)).state);assert.equal(refreshed.enrollments.length,2);assert.equal(refreshed.history.length,2);
});
