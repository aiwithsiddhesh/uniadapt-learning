import test from 'node:test';
import assert from 'node:assert/strict';
import {DatabaseSync} from 'node:sqlite';
import {readFileSync,readdirSync} from 'node:fs';
import {sampleCampus} from '../lib/sample.ts';
import {emptyAcademic,applyAcademic,previewPlacement,sectionPath,requireAcademicAdmin} from '../lib/academic.ts';
import {readAcademic,runAcademic,commitAcademic} from '../lib/academic-store.ts';
import {openCampus} from '../lib/store.ts';
import {applyAuthorized,scopedCampus,authorize} from '../lib/access.ts';
