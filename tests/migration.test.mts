import test from 'node:test';
import assert from 'node:assert/strict';
import {DatabaseSync} from 'node:sqlite';
import {readFileSync,readdirSync} from 'node:fs';
import {sampleCampus} from '../lib/sample.ts';
test('M01-M04 additive migrations preserve existing accounts, setup links and academic references',()=>{const sql=new DatabaseSync(':memory:');sql.exec('PRAGMA foreign_keys=ON');const files=readdirSync(new URL('../drizzle',import.meta.url)).filter(f=>f.endsWith('.sql')).sort();for(const file of files.slice(0,3))sql.exec(readFileSync(new URL('../drizzle/'+file,import.meta.url),'utf8'));sql.prepare('INSERT INTO campuses (owner_id,state,revision,updated_at) VALUES (?,?,0,?)').run('old-college',JSON.stringify(sampleCampus('Old learner')),'2026-10-13T00:00:00Z');sql.exec("INSERT INTO accounts (id,campus_id,email,name,role,active,created_at) VALUES ('old-teacher','old-college','teacher@example.invalid','Existing Teacher','TEACHER',1,'2026-10-01'); INSERT INTO auth_tokens (hash,account_id,purpose,expires_at,created_at) VALUES ('hashed-token','old-teacher','setup',9999999999999,'2026-10-01'); INSERT INTO academic_institutes (id,name,timezone) VALUES ('old-college','Existing College','Asia/Kolkata'); INSERT INTO academic_departments (id,campus_id,code,name,active) VALUES ('dep','old-college','ENG','Engineering',1); INSERT INTO academic_programs (id,campus_id,department_id,code,name,duration_semesters,active) VALUES ('prog','old-college','dep','BE','BE',8,1); INSERT INTO academic_batches (id,campus_id,program_id,code,start_year,end_year,active) VALUES ('batch','old-college','prog','2026',2026,2030,1); INSERT INTO academic_semesters (id,campus_id,batch_id,number,start_date,end_date,active) VALUES ('sem','old-college','batch',1,'2026-10-01','2027-02-01',1); INSERT INTO academic_sections (id,campus_id,semester_id,name,capacity,active) VALUES ('sec','old-college','sem','A',60,1); INSERT INTO academic_subjects (id,campus_id,program_id,semester_no,code,name,credits,type,group_required,content_course_id,owner_teacher_id,active) VALUES ('sub','old-college','prog',1,'CS','CS',3,'CORE_THEORY',0,'old-course','old-teacher',1); INSERT INTO academic_offerings (id,campus_id,subject_id,section_id,course_id,exam,status,capacity) VALUES ('off','old-college','sub','sec','old-course-a','2027-01-20','ACTIVE',60); INSERT INTO academic_assignments (id,campus_id,offering_id,teacher_id,role) VALUES ('assign','old-college','off','old-teacher','PRIMARY');");const before=sql.prepare('SELECT state FROM campuses').get()!.state;for(const file of files.slice(3))sql.exec(readFileSync(new URL('../drizzle/'+file,import.meta.url),'utf8'));assert.equal(sql.prepare('SELECT name FROM accounts').get()!.name,'Existing Teacher');assert.equal(sql.prepare('SELECT hash FROM auth_tokens').get()!.hash,'hashed-token');assert.equal(sql.prepare('SELECT teacher_id FROM academic_assignments').get()!.teacher_id,'old-teacher');assert.equal(sql.prepare('SELECT state FROM campuses').get()!.state,before);assert.equal(sql.prepare('PRAGMA foreign_key_check').all().length,0);assert.equal(sql.prepare('SELECT active FROM academic_institutes').get()!.active,1);});
