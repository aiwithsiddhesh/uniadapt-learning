const CONFIG={secret:'test-only-foundation-auth-secret-over-32-chars',issuer:'uniadapt-learning'};
async function place(f:Awaited<ReturnType<typeof setup>>,section=0,learnerId='learner-me'){const action:AcademicAction={type:'previewPlacement',learnerId,sectionId:f.data.sections[section].id,rollNo:'ROLL-'+learnerId,electiveSubjectIds:[]};const p=await f.act(action) as {preview:PlacementPreview};await f.act({...action,type:'confirmPlacement',previewHash:p.preview.hash});}
const csvHeader='roll_no,name,email,department,program,batch,semester,section,electives\r\n';
test('M01 optional username and email authenticate the same account and share throttle state',async()=>{const f=await setup(),id=await saveAccount(f.db,admin,{action:'create',name:'Lecturer',email:'lecturer@example.invalid',username:'lecturer01',role:'TEACHER'},NOW),link=await createInvitation(f.db,admin,id,'setup',NOW);await acceptInvitation(f.db,link.token,'Strong lecturer password 123',CONFIG,'setup-ip',NOW);assert.equal((await login(f.db,'LECTURER01','Strong lecturer password 123',CONFIG,'login-ip',NOW)).user.id,id);for(let i=0;i<3;i++)await assert.rejects(()=>login(f.db,'lecturer@example.invalid','wrong',CONFIG,'ip1',NOW));for(let i=0;i<2;i++)await assert.rejects(()=>login(f.db,'lecturer01','wrong',CONFIG,'ip2',NOW));await assert.rejects(()=>login(f.db,'lecturer01','Strong lecturer password 123',CONFIG,'ip3',NOW),(e:unknown)=>e instanceof ProductError&&e.status===429);await assert.rejects(()=>saveAccount(f.db,admin,{action:'create',name:'Duplicate',email:'duplicate@example.invalid',username:'Lecturer01',role:'TEACHER'},NOW),/username/);});
test('M03 multiple PRIMARY Teachers remain distinct from the single shared Subject Owner',async()=>{const f=await setup(),o=f.data.offerings[0];await f.act({type:'saveOffering',id:o.id,subjectId:o.subjectId,sectionId:o.sectionId,exam:o.exam,capacity:o.capacity,status:'ACTIVE',teacherIds:['teacher','co'],primaryTeacherIds:['teacher','co'],ownerTeacherId:'co'});assert.deepEqual(f.data.offerings[0].primaryTeacherIds,['teacher','co']);assert.equal(f.data.subjects[0].ownerTeacherId,'co');assert.equal(f.sql.prepare("SELECT COUNT(*) AS n FROM academic_assignments WHERE offering_id = ? AND role='PRIMARY'").get(o.id)!.n,2);});
test('M04 planning spans the whole deadline horizon and stops study before exact exam start',async()=>{const f=await setup();await calendar(f);await place(f);let c=(await openCampus(f.db,'college','x',NOW)).state,course=c.courses.find(s=>s.id===f.data.offerings[0].courseId)!;course.curriculumApproved=course.bankApproved=true;course.topics.forEach(t=>t.coverage='COVERED');c.learners[0].availability=[36,37];assert.equal(makePlan(c,'learner-me',NOW).availableHours,13);course.exams=[{id:'e',offeringId:f.data.offerings[0].id,type:'UNIVERSITY',startAt:zonedToUTC('2027-01-20T10:00','Asia/Kolkata'),endAt:zonedToUTC('2027-01-20T12:00','Asia/Kolkata')}];course.topics.forEach(t=>t.hours=40);c.learners[0].availability=Array.from({length:336},(_,i)=>i);const plan=makePlan(c,'learner-me',new Date('2027-01-20T00:00:00Z'));assert.equal(plan.availableHours,4);assert.ok(plan.slots.every(s=>s.date==='2027-01-20'&&s.time<'10:00'));assert.equal(plan.mode,'TRIAGE');});
async function calendar(f:Awaited<ReturnType<typeof setup>>){await f.act({type:'saveCalendar',semesterId:f.data.semesters[0].id,workingDays:[0,1,2,3,4,5],holidays:['2026-10-19'],windows:[{type:'IA',startDate:'2026-11-01',endDate:'2026-11-30'},{type:'PRACTICAL',startDate:'2027-01-01',endDate:'2027-01-31'},{type:'UNIVERSITY',startDate:'2027-01-01',endDate:'2027-01-31'}]});}
test('M01 account edits persist identity/profile and revoke old JWTs immediately',async()=>{const f=await setup(),old=await f.db.prepare("SELECT * FROM accounts WHERE id = 'student'").first<Account>(),token=await signSession(old!,CONFIG,NOW);const id=await saveAccount(f.db,admin,{action:'update',accountId:'student',name:'Updated learner',email:'NEW@example.invalid',role:'STUDENT',learnerId:'learner-me',departmentId:f.data.departments[0].id},NOW);assert.equal(id,'student');assert.equal((await openCampus(f.db,'college','x',NOW)).state.learners[0].name,'Updated learner');const account=await f.db.prepare('SELECT * FROM accounts WHERE id = ?').bind(id).first<Account>();assert.equal(account!.email,'new@example.invalid');assert.equal(account!.department_id,f.data.departments[0].id);await assert.rejects(()=>authenticate(f.db,token,CONFIG,NOW));assert.ok(f.sql.prepare('SELECT COUNT(*) AS n FROM security_audit').get()!.n);});
test('M01 rejects duplicate identities, invalid departments, role changes with responsibilities and non-Admin writes',async()=>{const f=await setup();await assert.rejects(()=>saveAccount(f.db,admin,{action:'create',name:'Duplicate',email:'teacher@example.invalid',role:'TEACHER'},NOW),/identity/);await assert.rejects(()=>saveAccount(f.db,admin,{action:'create',name:'Wrong department',email:'wrong@example.invalid',role:'TEACHER',departmentId:'external'},NOW),/Department/);await assert.rejects(()=>saveAccount(f.db,admin,{action:'update',accountId:'teacher',name:'Teacher',email:'teacher@example.invalid',role:'STUDENT'},NOW),/Reassign/);await assert.rejects(()=>saveAccount(f.db,{...admin,role:'STUDENT'}, {action:'create'},NOW),(e:unknown)=>e instanceof ProductError&&e.status===403);assert.equal(f.sql.prepare("SELECT COUNT(*) AS n FROM accounts WHERE email='wrong@example.invalid'").get()!.n,0);});
test('M01 account creation is atomic with Student record creation on SQL failure',async()=>{const f=await setup(),before=await openCampus(f.db,'college','x',NOW);f.sql.exec("CREATE TRIGGER reject_account BEFORE INSERT ON accounts WHEN NEW.email='reject@example.invalid' BEGIN SELECT RAISE(ABORT,'account rejected'); END");await assert.rejects(()=>saveAccount(f.db,admin,{action:'create',name:'Rejected',email:'reject@example.invalid',role:'STUDENT'},NOW),/rejected/);const after=await openCampus(f.db,'college','x',NOW);assert.equal(after.revision,before.revision);assert.equal(after.state.learners.length,before.state.learners.length);});
test('M01 setup/reset transaction rolls back token consumption and audit on password-write failure',async()=>{const f=await setup(),link=await createInvitation(f.db,admin,'student','reset',NOW);f.sql.exec("CREATE TRIGGER reject_password BEFORE UPDATE OF password_hash ON accounts WHEN NEW.id='student' BEGIN SELECT RAISE(ABORT,'password rejected'); END");await assert.rejects(()=>acceptInvitation(f.db,link.token,'Strong new password 123',CONFIG,'ip',NOW),/rejected/);assert.equal(f.sql.prepare('SELECT COUNT(*) AS n FROM auth_tokens').get()!.n,1);assert.equal(f.sql.prepare("SELECT COUNT(*) AS n FROM security_audit WHERE action LIKE 'Completed%'").get()!.n,0);});
test('M01 concurrent token acceptance succeeds exactly once',async()=>{const f=await setup(),link=await createInvitation(f.db,admin,'student','setup',NOW);const results=await Promise.allSettled([acceptInvitation(f.db,link.token,'Strong new password 123',CONFIG,'ip',NOW),acceptInvitation(f.db,link.token,'Another new password 123',CONFIG,'ip',NOW)]);assert.equal(results.filter(r=>r.status==='fulfilled').length,1);assert.equal(f.sql.prepare('SELECT token_version FROM accounts WHERE id = ?').get('student')!.token_version,1);assert.equal(f.sql.prepare('SELECT COUNT(*) AS n FROM auth_tokens').get()!.n,0);});
test('M01 configurable account/IP throttling applies to login and token failures',async()=>{const f=await setup();await f.act({type:'saveInstitute',name:'Institute',code:'INST',timezone:'Asia/Kolkata',active:true,authPolicy:{accountAttempts:2,ipAttempts:3,windowSeconds:60}});for(let i=0;i<2;i++)await assert.rejects(()=>login(f.db,'unknown@example.invalid','wrong',CONFIG,'ip',NOW),/Invalid email/);await assert.rejects(()=>login(f.db,'unknown@example.invalid','wrong',CONFIG,'ip',NOW),(e:unknown)=>e instanceof ProductError&&e.status===429);await assert.rejects(()=>login(f.db,'unknown@example.invalid','wrong',CONFIG,'ip',new Date(NOW.getTime()+60000)),(e:unknown)=>e instanceof ProductError&&e.status===401);});
test('M02 Institute identity/timezone persist and invalid timezone or unsafe deactivation fails',async()=>{const f=await setup();await f.act({type:'saveInstitute',name:'My institute',code:'KIT',timezone:'Etc/UTC',active:true,authPolicy:{accountAttempts:5,ipAttempts:20,windowSeconds:900}});const stored=await openCampus(f.db,'college','x',NOW);assert.equal(stored.state.timezone,'Etc/UTC');assert.equal(f.sql.prepare('SELECT code FROM academic_institutes').get()!.code,'KIT');await assert.rejects(()=>f.act({type:'saveInstitute',name:'Bad',code:'BAD',timezone:'Madeup/Zone',active:true,authPolicy:{accountAttempts:5,ipAttempts:20,windowSeconds:900}}),/valid IANA/);await assert.rejects(()=>f.act({type:'saveInstitute',name:'Closed',code:'KIT',timezone:'Etc/UTC',active:false,authPolicy:{accountAttempts:5,ipAttempts:20,windowSeconds:900}}),/Deactivate Departments/);});
test('M03 CSV parses BOM, quoted commas/newlines and rejects malformed/header errors',()=>{const rows=parseCSV('\uFEFF'+csvHeader+'R1,"Student, One\nName",a@example.invalid,ENG,BE,2026,1,A,\r\n');assert.equal(rows[0].fields.name,'Student, One\nName');assert.throws(()=>parseCSV('name,email\nX,a@example.invalid'),/requires unique columns/);assert.throws(()=>parseCSV(csvHeader+'R1,"broken'),/unterminated/);});
test('M03 mixed CSV imports valid rows only, assigns subjects and returns row errors',async()=>{const f=await setup(),csv=csvHeader+'R1,New Student,new@example.invalid,ENG,BE,2026,1,A,\r\nR2,Bad Student,bad@example.invalid,ENG,BE,2026,1,MISSING,\r\n';const p=await studentImport(f.db,admin,f.revision,csv,undefined,NOW) as {importPreview:{hash:string;valid:number;invalid:number}};assert.equal(p.importPreview.valid,1);assert.equal(p.importPreview.invalid,1);assert.equal(f.sql.prepare("SELECT COUNT(*) AS n FROM accounts WHERE email='new@example.invalid'").get()!.n,0);const result=await studentImport(f.db,admin,f.revision,csv,p.importPreview.hash,NOW) as {revision:number;importResult:{imported:number;rejected:number}};assert.equal(result.importResult.imported,1);assert.equal(result.importResult.rejected,1);const account=await f.db.prepare("SELECT * FROM accounts WHERE email='new@example.invalid'").first<Account>();assert.equal(account!.active,0);assert.equal(f.sql.prepare("SELECT COUNT(*) AS n FROM accounts WHERE email='bad@example.invalid'").get()!.n,0);const campus=await openCampus(f.db,'college','x',NOW);assert.deepEqual(campus.state.learners.find(l=>l.id===account!.learner_id)!.courseIds,[f.data.offerings[0].courseId]);const again=await studentImport(f.db,admin,result.revision,csv,undefined,NOW) as {importPreview:{hash:string}};await studentImport(f.db,admin,result.revision,csv,again.importPreview.hash,NOW);assert.equal(f.sql.prepare('SELECT COUNT(*) AS n FROM academic_enrollments').get()!.n,1);});
test('M03 CSV confirm requires exact preview and rolls back all valid rows if SQL fails',async()=>{const f=await setup(),csv=csvHeader+'R1,New Student,new@example.invalid,ENG,BE,2026,1,A,\n';await assert.rejects(()=>studentImport(f.db,admin,f.revision,csv,'wrong',NOW),/Preview this exact/);const p=await studentImport(f.db,admin,f.revision,csv,undefined,NOW) as {importPreview:{hash:string}};f.sql.exec("CREATE TRIGGER import_fail BEFORE INSERT ON accounts WHEN NEW.email='new@example.invalid' BEGIN SELECT RAISE(ABORT,'import failed'); END");await assert.rejects(()=>studentImport(f.db,admin,f.revision,csv,p.importPreview.hash,NOW),/failed/);assert.equal(f.sql.prepare('SELECT COUNT(*) AS n FROM academic_placements').get()!.n,0);assert.equal(f.sql.prepare('SELECT COUNT(*) AS n FROM academic_enrollments').get()!.n,0);});
test('M03 bulk transfer previews final capacity and commits the complete group with preserved history',async()=>{const f=await setup();await place(f);const stored=await openCampus(f.db,'college','x',NOW);stored.state.learners.push({id:'second',name:'Second',courseIds:[],availability:[],blackouts:[]});await saveCampus(f.db,'college',stored.revision,stored.state,NOW);const data=await readAcademic(f.db,'college',stored.state),first=data.placements[0],secondPreview={type:'previewPlacement' as const,learnerId:'second',rollNo:'SECOND',sectionId:data.sections[0].id,electiveSubjectIds:[]};let revision=(await openCampus(f.db,'college','x',NOW)).revision;const {runAcademic}=await import('../lib/academic-store.ts');const p=await runAcademic(f.db,admin,revision,secondPreview,NOW) as {preview:PlacementPreview};const placed=await runAcademic(f.db,admin,revision,{...secondPreview,type:'confirmPlacement',previewHash:p.preview.hash},NOW);revision=placed.revision;const a:AcademicAction={type:'previewBulkPlacement',learnerIds:[first.id,'second'],sectionId:data.sections[1].id,electiveSubjectIds:[]},preview=await runAcademic(f.db,admin,revision,a,NOW) as {bulkPreview:{hash:string;rows:PlacementPreview[]}};assert.equal(preview.bulkPreview.rows.length,2);await runAcademic(f.db,admin,revision,{...a,type:'confirmBulkPlacement',previewHash:preview.bulkPreview.hash},NOW);assert.equal(f.sql.prepare("SELECT COUNT(*) AS n FROM academic_enrollments WHERE status='ACTIVE'").get()!.n,2);assert.equal(f.sql.prepare("SELECT COUNT(*) AS n FROM academic_enrollments WHERE status='CLOSED'").get()!.n,2);assert.equal(f.sql.prepare('SELECT COUNT(*) AS n FROM academic_placement_history').get()!.n,4);});
test('M03 Unit-policy edits preserve active curriculum until Owner approval and retain old versions',async()=>{const f=await setup(),teacher={...admin,id:'teacher',role:'TEACHER' as const};let stored=await openCampus(f.db,'college','x',NOW);stored.state=applyAuthorized(stored.state,teacher,{type:'approveCurriculum',courseId:f.data.offerings[0].courseId},NOW);await saveCampus(f.db,'college',stored.revision,stored.state,NOW);const subject=f.data.subjects[0];const {runAcademic}=await import('../lib/academic-store.ts');stored=await openCampus(f.db,'college','x',NOW);await runAcademic(f.db,admin,stored.revision,{type:'saveSubject',id:subject.id,programId:subject.programId,semesterNo:1,code:subject.code,name:subject.name,credits:subject.credits,subjectType:subject.type,units:[{name:'Renamed Unit',weight:100}],active:true},NOW);stored=await openCampus(f.db,'college','x',NOW);const course=stored.state.courses.find(c=>c.id===f.data.offerings[0].courseId)!;assert.equal(course.units![0].name,'Unit 1');assert.equal(course.pendingUnitPolicy!.units[0].name,'Renamed Unit');assert.equal(course.curriculumApproved,true);assert.equal(f.sql.prepare('SELECT COUNT(*) AS n FROM academic_unit_policies').get()!.n,2);const next=applyAuthorized(stored.state,teacher,{type:'approveCurriculum',courseId:course.id},NOW);assert.equal(next.courses.find(c=>c.id===course.id)!.units![0].name,'Renamed Unit');assert.equal(next.courses.find(c=>c.id===course.id)!.curriculumUnitPolicyVersion,2);});
test('M04 timezone conversion handles non-hour offsets and rejects DST gaps/ambiguity',()=>{assert.equal(zonedToUTC('2026-10-13T12:00','Asia/Kolkata'),'2026-10-13T06:30:00.000Z');assert.equal(zonedToUTC('2026-03-08T01:30','America/New_York'),'2026-03-08T06:30:00.000Z');assert.throws(()=>zonedToUTC('2026-03-08T02:30','America/New_York'),/does not exist/);assert.throws(()=>zonedToUTC('2026-11-01T01:30','America/New_York'),/ambiguous/);});
test('M04 calendar validates term dates, holidays and exam windows with immutable versions',async()=>{const f=await setup();await calendar(f);assert.equal(f.data.calendars![0].version,1);assert.equal(f.data.calendarVersions!.length,1);await assert.rejects(()=>f.act({type:'saveCalendar',semesterId:f.data.semesters[0].id,workingDays:[0],holidays:['2030-01-01'],windows:[]}),/holiday/);await assert.rejects(()=>f.act({type:'saveCalendar',semesterId:f.data.semesters[0].id,workingDays:[0],holidays:[],windows:[{type:'UNIVERSITY',startDate:'2027-01-01',endDate:'2027-01-25'},{type:'UNIVERSITY',startDate:'2027-01-20',endDate:'2027-01-31'}]}),/cannot overlap/);assert.equal(f.sql.prepare('SELECT COUNT(*) AS n FROM academic_calendar_versions').get()!.n,1);});
test('M04 timetable rejects Section/Teacher overlaps, allows adjacency and records corrections/removal',async()=>{const f=await setup();await calendar(f);const a:AcademicAction={type:'saveTimetable',sectionId:f.data.sections[0].id,offeringId:f.data.offerings[0].id,day:0,kind:'CLASS',startTime:'09:00',endTime:'10:00',startDate:'2026-10-01',endDate:'2027-02-01'};await f.act(a);await assert.rejects(()=>f.act({...a,startTime:'09:30',endTime:'10:30'}),/overlap/);await assert.rejects(()=>f.act({...a,sectionId:f.data.sections[1].id,offeringId:f.data.offerings[1].id}),/Teacher/);await f.act({...a,startTime:'10:00',endTime:'11:00',kind:'LAB'});assert.equal(f.data.timetables!.length,2);await f.act({type:'removeTimetable',id:f.data.timetables![0].id});assert.equal(f.data.timetables!.length,1);assert.equal(f.sql.prepare('SELECT COUNT(*) AS n FROM academic_calendar_versions').get()!.n,4);});
test('M04 exact exam events fit windows and reject mandatory-event overlaps',async()=>{const f=await setup();await calendar(f);const a:AcademicAction={type:'saveExams',offeringId:f.data.offerings[0].id,exams:[{type:'IA',startLocal:'2026-11-03T09:00',endLocal:'2026-11-03T10:00'},{type:'UNIVERSITY',startLocal:'2027-01-20T10:00',endLocal:'2027-01-20T12:00'}]};await f.act(a);assert.equal(f.data.offerings[0].exams![1].startAt,'2027-01-20T04:30:00.000Z');await assert.rejects(()=>f.act({...a,exams:[{type:'UNIVERSITY',startLocal:'2026-11-03T09:00',endLocal:'2026-11-03T10:00'}]}),/university deadline|window/);await assert.rejects(()=>f.act({type:'saveTimetable',sectionId:f.data.sections[0].id,offeringId:f.data.offerings[0].id,day:2,kind:'CLASS',startTime:'09:30',endTime:'10:30',startDate:'2026-10-01',endDate:'2027-02-01'}),/overlaps a mandatory/);assert.equal(f.sql.prepare('SELECT COUNT(*) AS n FROM academic_exams').get()!.n,2);});
test('M04 planner excludes holidays, nonworking days, classes/labs and timed exams',async()=>{const f=await setup();await calendar(f);await place(f);let stored=await openCampus(f.db,'college','x',NOW);const c=stored.state.courses.find(c=>c.id===f.data.offerings[0].courseId)!;c.curriculumApproved=c.bankApproved=true;c.topics.forEach(t=>t.coverage='COVERED');stored.state.learners[0].availability=Array.from({length:336},(_,i)=>i);c.timetableSlots=[{id:'slot',offeringId:f.data.offerings[0].id,sectionId:f.data.sections[0].id,day:0,kind:'LAB',startTime:'09:15',endTime:'10:15',startDate:'2026-10-01',endDate:'2027-02-01'}];c.exams=[{id:'exam',offeringId:f.data.offerings[0].id,type:'UNIVERSITY',startAt:zonedToUTC('2027-01-20T10:00','Asia/Kolkata'),endAt:zonedToUTC('2027-01-20T12:00','Asia/Kolkata')}];assert.ok(calendarUnavailable(c,'2026-10-19','11:00','Asia/Kolkata'));assert.ok(calendarUnavailable(c,'2026-10-18','11:00','Asia/Kolkata'));assert.ok(calendarUnavailable(c,'2026-10-26','09:00','Asia/Kolkata'));assert.ok(calendarUnavailable(c,'2027-01-20','10:30','Asia/Kolkata'));const plan=makePlan(stored.state,'learner-me',NOW);assert.ok(plan.slots.every(s=>!calendarUnavailable(c,s.date,s.time,'Asia/Kolkata')));});
test('M01 database query projection excludes peers, unassigned banks and unreleased keys',async()=>{const f=await setup();await place(f);let stored=await openCampus(f.db,'college','x',NOW);stored.state.learners.push({id:'private-peer',name:'SECRET PEER',courseIds:['mathematics'],availability:[],blackouts:[]});const student={...admin,id:'student',role:'STUDENT' as const,learnerId:'learner-me'};await saveCampus(f.db,'college',stored.revision,stored.state,NOW);const queried=await readRoleCampus(f.db,student,NOW);assert.equal(queried.state.learners.length,1);assert.ok(!JSON.stringify(queried.state).includes('SECRET PEER'));assert.ok(queried.state.courses.every(c=>!c.questions.length));const teacher={...admin,id:'co',role:'TEACHER' as const};const teaching=await readRoleCampus(f.db,teacher,NOW);assert.ok(teaching.state.courses.every(c=>c.subjectId));assert.ok(!JSON.stringify(teaching.state).includes('SECRET PEER'));const publicView=scopedCampus(queried.state,student,NOW);assert.equal(publicView.evidence.length,0);});
test('M01 SQL projection serves only the current question without keys or peer session identities',async()=>{const f=await setup();await place(f);const teacher={...admin,id:'teacher',role:'TEACHER' as const},student={...admin,id:'student',role:'STUDENT' as const,learnerId:'learner-me'};let stored=await openCampus(f.db,'college','x',NOW),c=stored.state;const id=f.data.offerings[0].courseId;c=applyAuthorized(c,teacher,{type:'approveCurriculum',courseId:id},NOW);c=applyAuthorized(c,teacher,{type:'approveBank',courseId:id},NOW);const topic=c.courses.find(x=>x.id===id)!.topics[0];c=applyAuthorized(c,teacher,{type:'coverage',courseId:id,topicId:topic.id,coverage:'COVERED',pin:false},NOW);c=applyAuthorized(c,student,{type:'startAttempt',learnerId:'learner-me',courseId:id,topicId:topic.id,mode:'practice'},NOW);const q=questionFor(c,c.attempts.at(-1)!)!;c.sessions=[{id:'s',courseId:id,kind:'CHECKPOINT',topicIds:[topic.id],learnerIds:['learner-me','SECRET-PEER-ID'],createdBy:'teacher',openAt:NOW.toISOString(),closeAt:new Date(NOW.getTime()+60000).toISOString(),durationMinutes:10,maxItems:5,supervised:true,releaseResults:false,questionIds:['HIDDEN-BANK-ID']}];await saveCampus(f.db,'college',stored.revision,c,NOW);const visible=(await readRoleCampus(f.db,student,NOW)).state;assert.equal(visible.courses.find(x=>x.id===id)!.questions.length,1);assert.equal(visible.courses.find(x=>x.id===id)!.questions[0].id,q.id);assert.ok(!Object.hasOwn(visible.courses.find(x=>x.id===id)!.questions[0],'correct'));assert.ok(!JSON.stringify(visible).includes('SECRET-PEER-ID'));assert.ok(!JSON.stringify(visible).includes('HIDDEN-BANK-ID'));});
test('M03 required elective offerings publish together with capacity-aware Admin-reviewed allocations',async()=>{const f=await setup();const csv=csvHeader+'R1,One,one@example.invalid,ENG,BE,2026,1,A,\nR2,Two,two@example.invalid,ENG,BE,2026,1,A,\n';const p=await studentImport(f.db,admin,f.revision,csv,undefined,NOW) as {importPreview:{hash:string}};await studentImport(f.db,admin,f.revision,csv,p.importPreview.hash,NOW);const {runAcademic}=await import('../lib/academic-store.ts');let stored=await openCampus(f.db,'college','x',NOW),revision=stored.revision,data=await readAcademic(f.db,'college',stored.state);const act=async(a:AcademicAction)=>{const r=await runAcademic(f.db,admin,revision,a,NOW);revision=r.revision;if('academic' in r&&r.academic)data=r.academic;return r;};
 for(const code of ['EL1','EL2']){await act({type:'saveSubject',programId:data.programs[0].id,semesterNo:1,code,name:code,credits:3,subjectType:'ELECTIVE',group:'Required group',groupRequired:true,units:[{name:'U1',weight:100}]});const s=data.subjects.at(-1)!;await act({type:'saveOffering',subjectId:s.id,sectionId:data.sections[0].id,exam:'2027-01-20',capacity:1,status:'DRAFT',teacherIds:['teacher'],primaryTeacherId:'teacher',ownerTeacherId:'teacher'});}
 const action:AcademicAction={type:'previewOfferingActivation',sectionId:data.sections[0].id,offeringIds:data.offerings.filter(o=>o.status==='DRAFT').map(o=>o.id)},preview=await act(action) as {bulkPreview:{hash:string;rows:PlacementPreview[]}};assert.equal(preview.bulkPreview.rows.length,2);assert.equal(new Set(preview.bulkPreview.rows.flatMap(r=>r.electiveSubjectIds)).size,2);await act({...action,type:'confirmOfferingActivation',previewHash:preview.bulkPreview.hash});assert.equal(data.offerings.filter(o=>o.status==='DRAFT').length,0);assert.ok(data.placements.every(p=>p.electiveSubjectIds.length===1));assert.equal(f.sql.prepare("SELECT COUNT(*) AS n FROM academic_enrollments WHERE status='ACTIVE'").get()!.n,4);
});
test('M03 foundation accepts 2,000 CSV records and bulk-transfers them with bounded SQL transactions',async()=>{const f=await setup(),csv=csvHeader+Array.from({length:1999},(_,i)=>`N${i},Student ${i},s${i}@example.invalid,ENG,BE,2026,1,A,`).join('\n');const p=await studentImport(f.db,admin,f.revision,csv,undefined,NOW) as {importPreview:{hash:string;valid:number}};assert.equal(p.importPreview.valid,1999);const imported=await studentImport(f.db,admin,f.revision,csv,p.importPreview.hash,NOW);const stored=await openCampus(f.db,'college','x',NOW);assert.equal(stored.state.learners.length,2000);assert.ok(Buffer.byteLength(JSON.stringify(stored.state))<1500000);const data=await readAcademic(f.db,'college',stored.state),{runAcademic}=await import('../lib/academic-store.ts'),a:AcademicAction={type:'previewBulkPlacement',learnerIds:data.placements.map(p=>p.id),sectionId:data.sections[1].id,electiveSubjectIds:[]};const preview=await runAcademic(f.db,admin,imported.revision,a,NOW) as {bulkPreview:{hash:string}};await runAcademic(f.db,admin,imported.revision,{...a,type:'confirmBulkPlacement',previewHash:preview.bulkPreview.hash},NOW);assert.equal(f.sql.prepare("SELECT COUNT(*) AS n FROM academic_enrollments WHERE status='CLOSED'").get()!.n,1999);assert.equal(f.sql.prepare("SELECT COUNT(*) AS n FROM academic_enrollments WHERE status='ACTIVE'").get()!.n,1999);const reloaded=await openCampus(f.db,'college','x',new Date(NOW.getTime()+86400000));assert.equal(reloaded.state.learners.length,2000);assert.equal(reloaded.state.plans.length,1);});
test('M04 timezone updates preserve exam instants and record a new immutable calendar snapshot',async()=>{const f=await setup();await calendar(f);await f.act({type:'saveExams',offeringId:f.data.offerings[0].id,exams:[{type:'UNIVERSITY',startLocal:'2027-01-20T10:00',endLocal:'2027-01-20T12:00'}]});const original=f.data.offerings[0].exams![0].startAt,before=f.data.calendarVersions!.length;await f.act({type:'saveInstitute',name:'Timezone institute',code:'TZ',timezone:'Etc/UTC',active:true,authPolicy:{accountAttempts:5,ipAttempts:20,windowSeconds:900}});assert.equal(f.data.offerings[0].exams![0].startAt,original);assert.equal(f.data.calendarVersions!.length,before+1);assert.equal((f.data.calendarVersions!.at(-1)!.calendar as unknown as {timezone:string}).timezone,'Etc/UTC');});
test('M02/M03 placement closure frees capacity and permits safe hierarchy deactivation without erasing history',async()=>{const f=await setup();await place(f);const a:AcademicAction={type:'previewPlacementClosure',learnerIds:['learner-me']},p=await f.act(a) as {bulkPreview:{hash:string}};await f.act({...a,type:'confirmPlacementClosure',previewHash:p.bulkPreview.hash});assert.equal(f.data.placements[0].active,false);assert.equal(f.data.history.at(-1)!.event,'CLOSED');assert.equal(f.data.enrollments[0].status,'CLOSED');assert.equal((await openCampus(f.db,'college','x',NOW)).state.learners[0].courseIds.length,0);
 for(const o of [...f.data.offerings])await f.act({type:'saveOffering',id:o.id,subjectId:o.subjectId,sectionId:o.sectionId,exam:o.exam,capacity:o.capacity,status:'DRAFT',teacherIds:o.teacherIds,primaryTeacherId:o.primaryTeacherId,ownerTeacherId:'teacher'});
 const subject=f.data.subjects[0];await f.act({type:'saveSubject',id:subject.id,programId:subject.programId,semesterNo:1,code:subject.code,name:subject.name,credits:3,subjectType:subject.type,units:subject.units,active:false});for(const s of [...f.data.sections])await f.act({type:'saveSection',id:s.id,semesterId:s.semesterId,name:s.name,capacity:s.capacity,active:false});const sem=f.data.semesters[0],batch=f.data.batches[0],program=f.data.programs[0],dept=f.data.departments[0];await f.act({type:'saveSemester',id:sem.id,batchId:sem.batchId,number:sem.number,startDate:sem.startDate,endDate:sem.endDate,active:false});await f.act({type:'saveBatch',id:batch.id,programId:batch.programId,code:batch.code,startYear:batch.startYear,endYear:batch.endYear,active:false});await f.act({type:'saveProgram',id:program.id,departmentId:program.departmentId,code:program.code,name:program.name,durationSemesters:8,active:false});await f.act({type:'saveDepartment',id:dept.id,code:dept.code,name:dept.name,active:false});await f.act({type:'saveInstitute',name:'Closed college',code:'CLOSED',timezone:'Asia/Kolkata',active:false,authPolicy:{accountAttempts:5,ipAttempts:20,windowSeconds:900}});assert.equal(f.data.institute.active,false);assert.equal(f.sql.prepare('SELECT COUNT(*) AS n FROM academic_enrollments').get()!.n,1);assert.equal(f.sql.prepare('SELECT COUNT(*) AS n FROM academic_placement_history').get()!.n,2);});
